<?xml version="1.0" encoding="utf-8"?>
<config>
	<!-- 生成分类 -->
	<category>
		<category value="dataset_curd" label="增删改查（单表_Dataset）">
			<template>dataset/controller.xml</template>
			<template>dataset/service.xml</template>
			<template>category-ref:dateset_dao</template>
			<template>dataset/viewManage.xml</template>
